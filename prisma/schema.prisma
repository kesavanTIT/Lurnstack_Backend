// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String   @unique
  password  String
  role      String   @default("student") // "admin" or "student"
  createdAt DateTime @default(now())
}

model LiveClass {
  id          Int      @id @default(autoincrement())
  courseName  String
  classTitle  String
  instructor  String
  description String?
  date        String
  time        String
  duration    String
  meetLink    String
  thumbnail   String?
  createdAt   DateTime @default(now())
}
