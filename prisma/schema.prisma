// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int              @id @default(autoincrement())
  fullName        String
  email           String           @unique
  password        String
  phoneNumber     String?          @unique
  phoneNormalized String?          @unique
  role            Role             @default(STUDENT)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  profilePhotoUrl String?          @map("PROFILE_PHOTO_URL")
  liveSessions        LiveSession[]
  sessionCards        SessionCard[]
  sessionBookings     SessionBooking[]
  attendances         Attendance[]
  bookings            Booking[]             @relation(name: "UserBookingRelation")
  passwordResetTokens PasswordResetToken[]
  payments                  Payment[]           @relation(name: "UserPaymentRelation")
  trainerEarnings           TrainerEarning[]    @relation(name: "TrainerEarningRelation")
  trainerPayouts            TrainerPayout[]     @relation(name: "TrainerPayoutRelation")
  trainerOccurrences        SessionOccurrence[] @relation(name: "TrainerSessionOccurrence")
  studentAttendances        StudentAttendance[] @relation(name: "StudentAttendance")
  trainerStudentAttendances StudentAttendance[] @relation(name: "TrainerStudentAttendance")
  whatsappReminders         WhatsAppReminder[]
  campaignDeliveries        OfferCampaignDelivery[]
  campaignClicks            OfferCampaignClick[]
  payoutAccount             TrainerPayoutAccount?
  payoutRequests            TrainerPayoutRequest[] @relation(name: "TrainerPayoutRequestRelation")
}

enum Role {
  STUDENT
  TRAINER
  ADMIN
}

model LiveClass {
  id              Int       @id @default(autoincrement())
  courseName      String
  classTitle      String
  instructor      String
  description     String?
  scheduledAt     DateTime? // Combined date and time for robust sorting/filtering
  durationMinutes Int? // Duration in minutes for easier calculations
  date            String
  time            String
  duration        String
  meetLink        String
  thumbnail       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  isRecurring     Boolean   @default(false)
  recurrenceType  String?
  sectionType     String?
  source          String?
}


model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  status      String   @default("active")
}

model LiveSession {
  id             String    @id @default(uuid())
  courseId       String?
  trainerId      Int
  trainer        User      @relation(fields: [trainerId], references: [id])
  title          String    @default("Live Session")
  subtitle       String?
  description    String?
  startTime      String?
  endTime        String?
  timezone       String    @default("Asia/Kolkata")
  meetingLink    String?
  isRecurring    Boolean   @default(false)
  recurrenceType String?
  status         String    @default("active")
  cancelledDates Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  endedAt        DateTime?

  // Preserving legacy columns to avoid data loss
  courseTitle     String?
  category        String?
  classTitle      String?
  thumbnail       String?
  scheduledDate   String?
  scheduledAt     String?
  endsAt          String?
  durationMinutes Int?

  cards       SessionCard[]
  bookings    SessionBooking[]
  attendances Attendance[]

  // Pricing fields added for new pricing flow
  priceInPaise                 Int?
  trainerSharePercentage       Float @default(50)
  platformCommissionPercentage Float @default(50)

  // ── Pricing & Publish State (new — safe defaults preserve all existing data) ──
  // pricingState: PENDING_PRICE | FREE | PRICED
  //   Default is PENDING_PRICE for newly created sessions.
  //   Existing sessions that already have priceInPaise set will be PRICED.
  pricingState  String @default("PENDING_PRICE")
  // publishState: DRAFT | PUBLISHED | CANCELLED | ENDED
  //   Default is PUBLISHED so all existing sessions remain visible to students.
  publishState  String @default("PUBLISHED")

  pricing         SessionPricing?  @relation(name: "SessionPricingRelation")
  billingBookings Booking[]        @relation(name: "SessionBookingRelation")
  payments        Payment[]        @relation(name: "SessionPaymentRelation")
  trainerEarnings TrainerEarning[] @relation(name: "SessionEarningRelation")
  trainerPayouts  TrainerPayout[]  @relation(name: "SessionPayoutRelation")
  occurrences        SessionOccurrence[]
  studentAttendances StudentAttendance[]
  whatsappReminders    WhatsAppReminder[]

  recordingUrl    String?
  materials       String?
}

model SessionCard {
  id        String      @id @default(uuid())
  sessionId String
  studentId Int
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  addedAt   DateTime    @default(now())

  @@unique([sessionId, studentId])
}

model SessionBooking {
  id          String      @id @default(uuid())
  sessionId   String
  studentId   Int
  session     LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  meetingLink String?
  joinedAt    DateTime    @default(now())

  @@unique([sessionId, studentId])
}

model Attendance {
  id                   String            @id @default(uuid())
  studentId            Int
  sessionId            String
  joinDate             String?           // Restored to prevent data loss
  joinedAt             DateTime?         @default(now()) // Restored to prevent data loss
  occurrenceDate       DateTime          @default(now())
  status               String            @default("pending") // pending, present, late, absent
  firstJoinedAt        DateTime          @default(now())
  lastJoinedAt         DateTime          @default(now())
  joinCount            Int               @default(1)
  totalDurationSeconds Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @default(now()) @updatedAt

  session              LiveSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student              User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  isJoined             Boolean           @default(false)

  events               AttendanceEvent[]

  // TEMPORARILY COMMENTED OUT FOR MIGRATION
  // @@unique([studentId, sessionId, occurrenceDate])
}

model AttendanceEvent {
  id              String      @id @default(uuid())
  attendanceId    String
  studentId       Int
  sessionId       String
  occurrenceDate  DateTime    @default(now())
  joinedAt        DateTime    @default(now())
  leftAt          DateTime?
  durationSeconds Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt

  attendance      Attendance  @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
}

model SessionPricing {
  id                        String      @id @default(uuid())
  sessionId                 String      @unique
  session                   LiveSession @relation(name: "SessionPricingRelation", fields: [sessionId], references: [id], onDelete: Cascade)
  amountPaise               Int
  currency                  String      @default("INR")
  trainerSharePercent       Float
  platformCommissionPercent Float
  isActive                  Boolean     @default(true)
  createdByAdminId          Int
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt
}

model Booking {
  id              String           @id @default(uuid())
  studentId       Int
  student         User             @relation(name: "UserBookingRelation", fields: [studentId], references: [id], onDelete: Cascade)
  sessionId       String
  session         LiveSession      @relation(name: "SessionBookingRelation", fields: [sessionId], references: [id], onDelete: Cascade)
  sessionDate     DateTime
  amountPaise     Int
  currency        String           @default("INR")
  status          BookingStatus    @default(pending_payment)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  payments        Payment[]        @relation(name: "BookingPaymentRelation")
  trainerEarnings TrainerEarning[] @relation(name: "BookingEarningRelation")

  // WhatsApp reminder tracking
  whatsappReminderSentAt    DateTime?
  whatsappReminderMessageId String?
  whatsappReminderStatus    String?
  whatsappReminderError     String?

  accessScope               String           @default("session")
  courseId                  String?
}

enum BookingStatus {
  pending_payment
  paid
  failed
  cancelled
  refunded
  joined
  completed
}

model Payment {
  id                String           @id @default(uuid())
  bookingId         String
  booking           Booking          @relation(name: "BookingPaymentRelation", fields: [bookingId], references: [id], onDelete: Cascade)
  studentId         Int
  student           User             @relation(name: "UserPaymentRelation", fields: [studentId], references: [id], onDelete: Cascade)
  sessionId         String
  session           LiveSession      @relation(name: "SessionPaymentRelation", fields: [sessionId], references: [id], onDelete: Cascade)
  razorpayOrderId   String           @unique
  razorpayPaymentId String?          @unique
  razorpaySignature String?
  amountPaise       Int
  currency          String           @default("INR")
  status            PaymentStatus    @default(created)
  paidAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  trainerEarnings   TrainerEarning[] @relation(name: "PaymentEarningRelation")
}

enum PaymentStatus {
  created
  authorized
  captured
  failed
  refunded
}

model TrainerEarning {
  id                      String               @id @default(uuid())
  trainerId               Int
  trainer                 User                 @relation(name: "TrainerEarningRelation", fields: [trainerId], references: [id], onDelete: Cascade)
  trainerName             String
  trainerEmail            String
  sessionId               String
  session                 LiveSession          @relation(name: "SessionEarningRelation", fields: [sessionId], references: [id], onDelete: Cascade)
  sessionTitle            String
  paidStudentCount        Int
  sessionPricePaise       Int
  grossRevenuePaise       Int
  trainerSharePercentage  Float
  trainerEarningPaise     Int
  platformSharePercentage Float
  platformEarningPaise    Int
  refundAdjustmentPaise   Int                  @default(0)
  finalPayablePaise       Int
  status                  TrainerEarningStatus @default(unpaid)
  lockedAmountPaise       Int                  @default(0)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  payoutRequestId         String?
  payoutRequest           TrainerPayoutRequest? @relation(name: "PayoutRequestEarningRelation", fields: [payoutRequestId], references: [id], onDelete: SetNull)

  // Legacy columns preserved as optional to prevent breaking references
  sessionDate             DateTime?
  bookingId               String?
  booking                 Booking?             @relation(name: "BookingEarningRelation", fields: [bookingId], references: [id], onDelete: Cascade)
  paymentId               String?
  payment                 Payment?             @relation(name: "PaymentEarningRelation", fields: [paymentId], references: [id], onDelete: Cascade)
  availableAfter          DateTime?
  paidAt                  DateTime?
}

enum TrainerEarningStatus {
  // Old values (retained to prevent database warnings/data loss on production)
  pending_session_completion
  payable
  failed
  on_hold
  cancelled

  // New values (added for Phase 1 manual payouts)
  unpaid
  requested
  approved
  processing
  paid
  rejected
  adjusted
}

model TrainerPayout {
  id                 String      @id @default(uuid())
  trainerId          Int
  trainer            User        @relation(name: "TrainerPayoutRelation", fields: [trainerId], references: [id], onDelete: Cascade)
  sessionId          String
  session            LiveSession @relation(name: "SessionPayoutRelation", fields: [sessionId], references: [id], onDelete: Cascade)
  sessionDate        DateTime
  amountPaise        Int
  status             String      @default("pending")
  razorpayTransferId String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model SessionOccurrence {
  id             String              @id @default(uuid())
  courseId       String
  sessionId      String
  session        LiveSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  trainerId      Int
  trainer        User                @relation(name: "TrainerSessionOccurrence", fields: [trainerId], references: [id])
  occurrenceDate DateTime            // Date-only representation for grouping
  startsAt       DateTime
  endsAt         DateTime
  status         String              @default("scheduled") // scheduled, live, completed
  finalizedAt    DateTime?
  // reminderSent: prevents duplicate 10-min reminder emails per occurrence
  reminderSent   Boolean             @default(false)
  attendances    StudentAttendance[]

  @@unique([sessionId, occurrenceDate])
}

model StudentAttendance {
  id             String            @id @default(uuid())
  courseId       String
  sessionId      String
  session        LiveSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  occurrenceId   String
  occurrence     SessionOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  occurrenceDate DateTime
  studentId      Int
  student        User              @relation(name: "StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  trainerId      Int
  trainer        User              @relation(name: "TrainerStudentAttendance", fields: [trainerId], references: [id], onDelete: Cascade)
  firstJoinedAt  DateTime          @default(now())
  lastJoinedAt   DateTime          @default(now())
  joinCount      Int               @default(1)
  status         String            // present, late, absent
  source         String            @default("join_button") // join_button, admin_manual
  finalizedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([occurrenceId, studentId])
}

// ─────────────────────────────────────────────────────────────────
// Password Reset Token — secure single-use token for forgot password
// ─────────────────────────────────────────────────────────────────
model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────
// OTP Verification — stores one-time codes for email / phone auth
// ─────────────────────────────────────────────────────────────────
model OTPVerification {
  id         Int      @id @default(autoincrement())
  identifier String   // email address or phone number
  code       String   // 6-digit OTP (stored as plain string)
  expiresAt  DateTime // set to now() + 1 minute at creation time
  createdAt  DateTime @default(now())
}

model WhatsAppReminder {
  id           String      @id @default(uuid())
  sessionId    String
  userId       Int
  phone        String
  status       String      // sent, failed, skipped
  messageId    String?
  error        String?
  sentAt       DateTime?
  reminderType String      @default("session_reminder_30min")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  session    LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId, reminderType])
}

model OfferCampaign {
  id               String                  @id @default(uuid())
  campaignName     String
  offerTitle       String
  description      String?
  discountType     String                  // "percentage" | "flat"
  discountValue    Float?
  theme            String?                 @default("light")
  validTill        DateTime
  categoryIds      String[]
  courseId         String?
  sessionId        String?
  audienceType     String                  // "all_students" | "category_students" | "course_students" | "session_students" | "inactive_students"
  subject          String
  heading          String
  body             String
  buttonText       String
  buttonLink       String
  showLogo         Boolean
  heroImageUrl     String?
  status           String                  @default("draft") // "draft" | "ready" | "sending" | "sent" | "failed"
  recipientCount   Int                     @default(0)
  sentCount        Int                     @default(0)
  failedCount      Int                     @default(0)
  createdByAdminId Int
  sentAt           DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  deliveries       OfferCampaignDelivery[]
  clicks           OfferCampaignClick[]
}

model OfferCampaignDelivery {
  id                String        @id @default(uuid())
  campaignId        String
  campaign          OfferCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  studentId         Int
  student           User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  email             String
  status            String        @default("pending") // "pending" | "sent" | "failed"
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model OfferCampaignClick {
  id         String        @id @default(uuid())
  campaignId String
  campaign   OfferCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  studentId  Int?
  student    User?         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  email      String?
  targetType String        // "session" | "course" | "category"
  targetId   String?
  clickedAt  DateTime      @default(now())
  userAgent  String?
  ipAddress  String?
}

model TrainerPayoutAccount {
  id                   String                     @id @default(uuid())
  trainerId            Int                        @unique
  trainer              User                       @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  accountHolderName    String
  bankName             String
  accountNumber        String                     // encrypted
  accountNumberLast4   String
  ifsc                 String
  upiId                String?
  pan                  String
  phoneNumber          String
  status               TrainerPayoutAccountStatus @default(pending)
  rejectionReason      String?
  verifiedByAdminId    Int?
  verifiedAt           DateTime?
  rejectedByAdminId    Int?
  rejectedAt           DateTime?
  isLocked             Boolean                    @default(false)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
}

enum TrainerPayoutAccountStatus {
  pending
  verified
  rejected
}

model TrainerPayoutAccountHistory {
  id              String   @id @default(uuid())
  payoutAccountId String
  trainerId       Int
  oldStatus       String
  newStatus       String
  adminId         Int?
  adminName       String?  // snapshot nullable
  note            String?
  createdAt       DateTime @default(now())
}

model TrainerPayoutRequest {
  id                             String                     @id @default(uuid())
  trainerId                      Int
  trainer                        User                       @relation(name: "TrainerPayoutRequestRelation", fields: [trainerId], references: [id], onDelete: Cascade)
  trainerName                    String                     // snapshot
  requestedAmountPaise           Int
  availableBalanceAtRequestPaise Int
  lockedAmountPaise              Int
  status                         TrainerPayoutRequestStatus @default(requested)
  payoutAccountSnapshot          Json                       // json
  adminNote                      String?
  rejectionReason                String?
  approvedByAdminId              Int?
  approvedAt                     DateTime?
  rejectedByAdminId              Int?
  rejectedAt                     DateTime?
  processingByAdminId            Int?
  processingAt                   DateTime?
  paidByAdminId                  Int?
  paidAt                         DateTime?
  utrReference                   String?
  manualPaidDate                 DateTime?
  createdAt                      DateTime                   @default(now())
  updatedAt                      DateTime                   @updatedAt

  earnings                       TrainerEarning[]           @relation(name: "PayoutRequestEarningRelation")
  history                        TrainerPayoutRequestHistory[]
}

enum TrainerPayoutRequestStatus {
  requested
  approved
  processing
  paid
  rejected
}

model TrainerPayoutRequestHistory {
  id              String                     @id @default(uuid())
  payoutRequestId String
  payoutRequest   TrainerPayoutRequest       @relation(fields: [payoutRequestId], references: [id], onDelete: Cascade)
  trainerId       Int
  action          TrainerPayoutRequestAction
  oldStatus       String
  newStatus       String
  adminId         Int?
  adminName       String?                    // snapshot nullable
  note            String?
  createdAt       DateTime                   @default(now())
}

enum TrainerPayoutRequestAction {
  requested
  approved
  rejected
  processing
  paid
}

model TrainerRefundAdjustment {
  id          String   @id @default(uuid())
  trainerId   Int
  amountPaise Int
  reason      String
  isApplied   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model TrainerPayoutAuditLog {
  id        String   @id @default(uuid())
  action    String
  actorId   Int
  details   Json
  createdAt DateTime @default(now())
}

