// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int              @id @default(autoincrement())
  fullName        String
  email           String           @unique
  password        String
  phoneNumber     String?
  role            Role             @default(STUDENT)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  liveSessions    LiveSession[]
  sessionCards    SessionCard[]
  sessionBookings SessionBooking[]
  attendances     Attendance[]
}

enum Role {
  STUDENT
  TRAINER
  ADMIN
}

model LiveClass {
  id              Int      @id @default(autoincrement())
  courseName      String
  classTitle      String
  instructor      String
  description     String?
  scheduledAt     DateTime? // Combined date and time for robust sorting/filtering
  durationMinutes Int?      // Duration in minutes for easier calculations
  date            String
  time            String
  duration        String
  meetLink        String
  thumbnail       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  isRecurring     Boolean  @default(false)
  recurrenceType  String?
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model LiveSession {
  id              String           @id @default(uuid())
  courseId        String?
  trainerId       Int
  trainer         User             @relation(fields: [trainerId], references: [id])
  title           String           @default("Live Session")
  subtitle        String?
  description     String?
  startTime       String?
  endTime         String?
  timezone        String           @default("Asia/Kolkata")
  meetingLink     String?
  isRecurring     Boolean          @default(false)
  recurrenceType  String?
  status          String           @default("active")
  cancelledDates  Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  endedAt         DateTime?
  
  // Preserving legacy columns to avoid data loss
  courseTitle     String?
  category        String?
  classTitle      String?
  thumbnail       String?
  scheduledDate   String?
  scheduledAt     String?
  endsAt          String?
  durationMinutes Int?

  cards           SessionCard[]
  bookings        SessionBooking[]
  attendances     Attendance[]
}

model SessionCard {
  id        String   @id @default(uuid())
  sessionId String
  studentId Int
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  addedAt   DateTime    @default(now())

  @@unique([sessionId, studentId])
}

model SessionBooking {
  id          String   @id @default(uuid())
  sessionId   String
  studentId   Int
  session     LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  meetingLink String?
  joinedAt    DateTime    @default(now())

  @@unique([sessionId, studentId])
}

model Attendance {
  id          String      @id @default(uuid())
  sessionId   String
  studentId   Int
  session     LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinDate    String      // YYYY-MM-DD
  joinedAt    DateTime    @default(now())
  status      String      @default("joined")

  @@unique([sessionId, studentId, joinDate])
}
