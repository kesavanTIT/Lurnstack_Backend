{
  "name": "lurnstack-backend",
  "version": "1.0.0",
  "description": "LurnStack Backend API - Node.js + Express + PostgreSQL + Prisma",
  "main": "src/server.js",
  "scripts": {
    "start": "npx prisma migrate deploy && node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "npx prisma migrate dev --name init",
    "prisma:studio": "npx prisma studio",
    "build": "prisma generate && prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.31.0",
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "prisma": "^5.14.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  },
  "keywords": [
    "lurnstack",
    "edtech",
    "backend",
    "express",
    "prisma"
  ],
  "author": "LurnStack",
  "license": "ISC"
}
