    # LurnStack Backend - Environment Variables Template
    # Copy this file to .env and configure the fields with your actual keys.
    # DO NOT commit the .env file to Git/GitHub.

    DATABASE_URL="postgresql://username:password@localhost:5432/databasename"
    JWT_SECRET="your_jwt_secret_key"
    PORT=5000

    # Razorpay credentials
    RAZORPAY_KEY_ID="rzp_test_..."
    RAZORPAY_KEY_SECRET="your_razorpay_secret"
    RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

    # ── OTP — SMS (Fast2SMS) ───────────────────────────────────────────────────────
    # SMS_MOCK_MODE=false → real SMS via Fast2SMS   |  true → just log to console
    SMS_MOCK_MODE=true
    FAST2SMS_API_KEY="your_fast2sms_api_key"
    # Route: 'q' = Quick SMS (no DLT needed) | 'dlt' = DLT-approved templates
    FAST2SMS_ROUTE=q

    # ── OTP — Email (Nodemailer SMTP / ZeptoMail) ──────────────────────────────────
    SMTP_HOST="smtp.zeptomail.in"
    SMTP_PORT=587
    SMTP_USER="your_smtp_username"
    SMTP_PASS="your_smtp_password"
    SMTP_FROM="no-reply@yourdomain.com"

    # ── Frontend URL (used in password reset email link) ──────────────────────────
    FRONTEND_URL="https://lurnstack.com"

    # ── Google OAuth ─────────────────────────────────────────────────────────────
    GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
    GOOGLE_CLIENT_SECRET="your_google_client_secret"
    GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

    # ── Meta WhatsApp Cloud API ──────────────────────────────────────────────────
    WHATSAPP_ENABLED=false
    WHATSAPP_GRAPH_VERSION="v23.0"
    WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
    WHATSAPP_ACCESS_TOKEN="your_whatsapp_access_token"
    WHATSAPP_TEMPLATE_SESSION_REMINDER="session_reminder"
    WHATSAPP_TEMPLATE_LANGUAGE="en"
    WHATSAPP_REMINDER_MINUTES_BEFORE=30
    SEND_FREE_SESSION_REMINDERS_TO_ALL=true
